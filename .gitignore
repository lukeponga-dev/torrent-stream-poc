# .gitignore

# Dependencies
node_modules/
package-lock.json
yarn.lock

# Environment
.env
.env.local
.env.*.local

# Build outputs
build/
dist/
*.tgz

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE
.vscode/
.idea/
*.iml
.sublime-project
.sublime-workspace

# Temp files
/tmp
*.tmp
*.temp

# Torrents
/torrents
/tmp/torrents/*

# Coverage
coverage/
.nyc_output/

# Other
.cache/
.turbo/
